{
  "expo": {
    "name": "ParkFlow",
    "slug": "parkflow",
    "scheme": "parkflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04352A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ps.parkflow.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ParkFlow uses your location to show nearby parking zones and confirm where you are parking.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "ps.parkflow.driver",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#04352A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkFlow uses your location to show nearby parking zones and confirm where you are parking."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
